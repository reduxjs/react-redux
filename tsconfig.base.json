{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "isolatedModules": true,
    "jsx": "react",
    "lib": ["DOM", "ESNext"],
    "module": "ESnext",
    "moduleResolution": "bundler",
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@internal/*": ["./src/*"],
      "react-redux": ["./src/index.ts"], // @remap-prod-remove-line
      // `moduleResolution: "Node"` predates `exports` maps, so it cannot
      // find the types for alien-signals' `./system` subpath export.
      // Vite and tsup both resolve it correctly at runtime; this only
      // points the type checker at the declarations.
      "alien-signals/system": ["./node_modules/alien-signals/types/system.d.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESnext",
    "types": ["node", "vitest/globals", "vitest/importMeta"]
  },
  "exclude": ["dist", "website", "docs", "examples"]
}
