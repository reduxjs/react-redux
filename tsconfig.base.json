{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "isolatedModules": true,
    "jsx": "react",
    "lib": ["DOM", "ESNext"],
    "module": "ESnext",
    "moduleResolution": "bundler",
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@internal/*": ["./src/*"],
      // Type-level counterpart to the `react-redux` alias in
      // `vitest.config.mts`. The type tests resolve through tsconfig
      // paths rather than the Vite alias, so they must point at the same
      // stock entry — otherwise a benchmark override in `src/exports.ts`
      // silently changes what the type tests are checking.
      "react-redux": ["./test/entries/stock.ts"] // @remap-prod-remove-line
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESnext",
    "types": ["node", "vitest/globals", "vitest/importMeta"]
  },
  "exclude": ["dist", "website", "docs", "examples"]
}
